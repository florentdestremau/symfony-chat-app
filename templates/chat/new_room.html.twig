{% extends 'base.html.twig' %}

{% block title %}Nouvelle salle - Chat App{% endblock %}

{% block body %}
    <div class="card" style="max-width: 500px; margin: 2rem auto;">
        <h2 class="card-title">Créer une nouvelle salle</h2>

        <form method="POST" action="{{ path('app_room_new') }}">
            <div class="form-group">
                <label for="name">Nom de la salle</label>
                <input type="text" id="name" name="name" required
                       placeholder="Ex: Général, Random, Tech..." autofocus>
            </div>

            <div style="display: flex; gap: 1rem;">
                <a href="{{ path('app_rooms') }}" class="btn btn-secondary">
                    Annuler
                </a>
                <button type="submit" class="btn" style="flex: 1;">
                    Créer la salle
                </button>
            </div>
        </form>
    </div>
{% endblock %}
